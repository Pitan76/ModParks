# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# wrangler
/.wrangler/
/.open-next/
/memo/
/mp-recipe/
/modparks-recipe/

# 本番DBのダンプ。OAuth アクセストークン等の実データを含むため絶対にコミットしない
# （sync2local.mjs が一時的に生成し、正常終了時は自動削除される）
remote_data.sql
*.dump.sql
backup_before_*.sql
